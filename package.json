{
  "name": "learn-what-you-own",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/normalize-worker-config.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx scripts/validate-featured-dossiers.ts && node --import tsx --test tests/news-text.test.ts tests/sec-news.test.ts tests/sec-request.test.ts tests/sec-share-facts.test.ts tests/sec-ownership.test.ts tests/comparable-metrics.test.ts tests/contribution-research-assets.test.ts tests/earnings-math.test.ts tests/earnings-model.test.ts tests/external-research-links.test.ts tests/valuation-history.test.ts tests/dossier-freshness.test.ts tests/dossier-completion.test.ts tests/community-platform.test.ts tests/company-logo-contrast.test.ts tests/seo.test.ts tests/supabase-backup-retry.test.mjs tests/d1-backup-sql.test.mjs tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "backup:production": "node --env-file-if-exists=.env.local scripts/backup-production.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "release:preflight": "node scripts/verify-production-config.mjs",
    "verify:authority": "node scripts/verify-authority-parity.mjs",
    "seo:audit": "node scripts/audit-public-seo.mjs",
    "sites:package": "node scripts/package-sites-release.mjs",
    "sites:verify-archive": "node scripts/verify-sites-archive.mjs",
    "deploy:production": "npm run build && npm run release:preflight && node scripts/deploy-production.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed:dossiers": "node --import tsx scripts/generate-dossier-seed.ts",
    "db:seed:company-overlay": "node --import tsx scripts/generate-company-index-overlay.ts",
    "db:seed:sec-facts": "node --import tsx scripts/generate-sec-facts-seed.ts",
    "db:migration:production-consistency": "node --import tsx scripts/generate-production-consistency-migration.ts",
    "sec:audit-shares": "node --import tsx scripts/audit-share-count-coverage.ts",
    "sec:update": "node scripts/update-sec-companies.mjs",
    "universe:update": "node scripts/update-exchange-universe.mjs",
    "yc:update": "node scripts/import-yc-class-profiles.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260804.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "docx": "^9.7.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "supabase": "2.111.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "type": "module"
}
